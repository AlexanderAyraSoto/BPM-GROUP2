    <bpmn2:userTask id="_0DD8B3C7-BBFC-404D-9AD0-270BA9670C68" name="Solicitar Vacaciones">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Solicitar Vacaciones]]></drools:metaValue>
        </drools:metaData>
        <drools:onEntry-script scriptFormat="http://www.javascript.com/javascript">
          <drools:script><![CDATA[var inicio = new Date(fechaInicio);
var fin = new Date(fechaFin);

var diferencia = fin.getTime() - inicio.getTime();

diasSolicitados = Math.floor(diferencia / (1000 * 60 * 60 * 24)) + 1;]]></drools:script>
        </drools:onEntry-script>
      </bpmn2:extensionElements>
